{
  "cli": {
    "version": ">= 5.9.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release",
        "resourceClass": "m-medium",
        "cache": {
          "key": "ios-production-{{ platform }}-{{ hash }}"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
} 