{
  "expo": {
    "name": "TLC PharmaSight",
    "slug": "tlc-pharmasight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tlcpharmacy.pharmasight"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111827"
      },
      "package": "com.tlcpharmacy.pharmasight"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "TLC PharmaSight",
      "shortName": "PharmaSight",
      "description": "Comprehensive pharmacy analytics dashboard for TLC pharmacies",
      "backgroundColor": "#111827",
      "themeColor": "#FF4500",
      "display": "standalone",
      "orientation": "any"
    },
    "plugins": []
  }
}
